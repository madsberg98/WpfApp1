<Window x:Class="WpfApp1.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.UI"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>

        <TextBlock Text="{Binding CurrentQuestion.QuestionText}"
                   HorizontalAlignment="Left"
                   Margin="51,85,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Height="53"
                   Width="243"/>

        <TextBlock Text="{Binding CurrentScore}"
                   HorizontalAlignment="Left"
                   Margin="44,0,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Height="68"
                   Width="244"/>

        <TextBlock Text="{Binding StatusMessage}"
                   HorizontalAlignment="Left"
                   Margin="44,294,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Height="44"
                   Width="244"/>

        <RadioButton Command="{Binding AnswerCommand}"
                     CommandParameter="{Binding SvarIndex}"
                     Content="RadioButton"
                     HorizontalAlignment="Left"
                     Margin="363,263,0,0"
                     VerticalAlignment="Top"/>

        <RadioButton Command="{Binding AnswerCommand}"
                     CommandParameter="{Binding SvarIndex}"
                     Content="RadioButton"
                     HorizontalAlignment="Left"
                     Margin="363,293,0,0"
                     VerticalAlignment="Top"/>

        <RadioButton Command="{Binding AnswerCommand}"
                     CommandParameter="{Binding SvarIndex}"
                     Content="RadioButton"
                     HorizontalAlignment="Left"
                     Margin="363,325,0,0"
                     VerticalAlignment="Top"/>

        <RadioButton Command="{Binding AnswerCommand}"
                     CommandParameter="{Binding SvarIndex}"
                     Content="RadioButton"
                     HorizontalAlignment="Left"
                     Margin="363,236,0,0"
                     VerticalAlignment="Top"/>

        <ProgressBar Value="{Binding ProgressValue}"
                     HorizontalAlignment="Left"
                     Height="33"
                     Margin="467,96,0,0"
                     VerticalAlignment="Top"
                     Width="265"/>

        <!-- Slutskærm -->
        <StackPanel Visibility="{Binding IsQuizFinished, Converter={StaticResource BoolToVis}}">

            <TextBlock Text="Quiz færdig!"
                       FontSize="20"/>

            <TextBlock Text="{Binding CurrentScore}"/>

            <Button Content="Start igen"/>

        </StackPanel>

    </Grid>
</Window>